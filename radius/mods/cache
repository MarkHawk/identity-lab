# rlm_cache: who passed the first factor, keyed on the State this server
# sent with its Access-Challenge. The second Access-Request must bring the
# same State back for the same User-Name, within a minute, or it's rejected,
# so the code step can't be reached without the password.
cache mfa_state {
	driver = "rlm_cache_rbtree"
	key = "%{control:Tmp-String-0}"
	ttl = 60
	add_stats = no
	update {
		&control:Tmp-String-1 := &User-Name
	}
}

# rlm_cache: spent one-time codes. After a code is accepted, the lab records
# this (user, code) here and refuses it again for as long as the code stays
# valid, so a one-time code really is one-time even when offered more than
# once. ttl 90 covers the code's whole validity (the step either side of now,
# as mods/totp allows: three 30-second steps). Kept in memory (rbtree), so a
# restart forgets it, like mfa_state above.
cache totp_used {
	driver = "rlm_cache_rbtree"
	key = "%{User-Name}:%{TOTP-Password}"
	ttl = 90
	add_stats = no
	update {
		&control:Tmp-String-3 := "used"
	}
}
