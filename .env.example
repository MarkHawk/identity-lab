# You do not need to copy this: scripts/setup.sh generates .env with random values.
# This file documents the variables. Never commit a real .env.

# Hostname browsers use to reach the lab. Use localhost in CI.
LAB_HOST=idlab.home
# Containers run as this UID so private keys can stay mode 0600.
LAB_UID=1000

# Host ports (lab is restricted to 8180-8189).
KC_PORT=8180
SAML_SP_PORT=8181
OIDC_RP_PORT=8182

KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=change-me
POSTGRES_PASSWORD=change-me
# Shared password for demo users alice, bob, carol.
DEMO_PASSWORD=change-me
OIDC_CLIENT_SECRET=change-me
SAML_SP_SECRET_KEY=change-me
OIDC_RP_SECRET_KEY=change-me

# Base64 DER of certs/sp-signing.crt (public, filled in by setup.sh).
SP_SIGNING_CERT=
