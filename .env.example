# You do not need to copy this: scripts/setup.sh generates .env with random values.
# This file documents the variables. Never commit a real .env.

# Hostname browsers use to reach the lab. Use localhost in CI.
LAB_HOST=idlab.home
# Containers run as this UID so private keys can stay mode 0600.
LAB_UID=1000

# Host ports (lab is restricted to 8180-8189).
KC_PORT=8180
SAML_SP_PORT=8181
OIDC_RP_PORT=8182
# The same three, through the nginx reverse proxy.
PROXY_KC_PORT=8183
PROXY_SAML_SP_PORT=8184
PROXY_OIDC_RP_PORT=8185
# The OIDC RP whose calls to Keycloak go through the Squid egress proxy.
EGRESS_OIDC_RP_PORT=8186

KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=change-me
POSTGRES_PASSWORD=change-me
# Shared password for demo users alice, bob, carol (Keycloak) and dave, erin, frank (LDAP).
DEMO_PASSWORD=change-me
OIDC_CLIENT_SECRET=change-me
# Client secret of oidc-rp-proxied, the OIDC RP behind the proxy.
OIDC_PROXIED_CLIENT_SECRET=change-me
# Client secret of oidc-rp-egress, the OIDC RP behind the egress proxy.
OIDC_EGRESS_CLIENT_SECRET=change-me
SAML_SP_SECRET_KEY=change-me
OIDC_RP_SECRET_KEY=change-me
# LDAP root DN (cn=admin,dc=idlab,dc=example) and Keycloak's bind account
# (cn=keycloak-svc,ou=services,dc=idlab,dc=example). Generated by setup.sh.
LDAP_ADMIN_PASSWORD=
LDAP_BIND_PASSWORD=
# FreeRADIUS's search account (cn=radius-svc,ou=services,dc=idlab,dc=example)
# and the RADIUS shared secret between FreeRADIUS and the lab NAS. Generated by setup.sh.
RADIUS_LDAP_BIND_PASSWORD=
RADIUS_SECRET=
# Password of egress-svc, the account the Squid egress proxy asks for when
# proxy login is on. Generated by setup.sh.
EGRESS_PROXY_PASSWORD=

# Base64 DER of certs/sp-signing.crt (public, filled in by setup.sh).
SP_SIGNING_CERT=
