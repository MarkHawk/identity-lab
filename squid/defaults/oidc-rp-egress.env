# Proxy settings of oidc-rp-egress (compose env_file), as an app team sets
# them on a server whose only way out is the egress proxy. Python's requests
# and urllib read them. NO_PROXY keeps the app's own healthcheck
# (https://localhost:8182) off the proxy.
# Healthy default; scenarios/proxy-bypass.sh rewrites the copy in .state/oidc-rp-egress/.
HTTPS_PROXY=http://squid:3128
NO_PROXY=localhost,127.0.0.1
