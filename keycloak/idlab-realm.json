{
  "realm": "idlab",
  "displayName": "Identity Lab",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "eventsListeners": ["jboss-logging"],
  "roles": {
    "realm": [
      { "name": "lab-user", "description": "Can sign in to the sample apps" },
      { "name": "lab-admin", "description": "Lab administrator (demo role)" }
    ]
  },
  "users": [
    {
      "username": "alice",
      "email": "alice@idlab.example",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Anderson",
      "enabled": true,
      "realmRoles": ["lab-user", "lab-admin", "default-roles-idlab"],
      "credentials": [{ "type": "password", "value": "${DEMO_PASSWORD}", "temporary": false }]
    },
    {
      "username": "bob",
      "email": "bob@idlab.example",
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "Brown",
      "enabled": true,
      "realmRoles": ["lab-user", "default-roles-idlab"],
      "credentials": [{ "type": "password", "value": "${DEMO_PASSWORD}", "temporary": false }]
    },
    {
      "username": "carol",
      "email": "carol@idlab.example",
      "emailVerified": true,
      "firstName": "Carol",
      "lastName": "Chen",
      "enabled": true,
      "realmRoles": ["default-roles-idlab"],
      "credentials": [{ "type": "password", "value": "${DEMO_PASSWORD}", "temporary": false }]
    }
  ],
  "components": {
    "org.keycloak.storage.UserStorageProvider": [
      {
        "name": "idlab-ldap",
        "providerId": "ldap",
        "config": {
          "enabled": ["true"],
          "priority": ["0"],
          "vendor": ["other"],
          "connectionUrl": ["ldaps://ldap:1636"],
          "useTruststoreSpi": ["always"],
          "connectionPooling": ["false"],
          "authType": ["simple"],
          "bindDn": ["cn=keycloak-svc,ou=services,dc=idlab,dc=example"],
          "bindCredential": ["${LDAP_BIND_PASSWORD}"],
          "usersDn": ["ou=people,dc=idlab,dc=example"],
          "searchScope": ["1"],
          "userObjectClasses": ["inetOrgPerson"],
          "usernameLDAPAttribute": ["uid"],
          "rdnLDAPAttribute": ["uid"],
          "uuidLDAPAttribute": ["entryUUID"],
          "editMode": ["READ_ONLY"],
          "importEnabled": ["true"],
          "syncRegistrations": ["false"],
          "trustEmail": ["true"],
          "pagination": ["false"],
          "cachePolicy": ["DEFAULT"],
          "fullSyncPeriod": ["-1"],
          "changedSyncPeriod": ["-1"]
        },
        "subComponents": {
          "org.keycloak.storage.ldap.mappers.LDAPStorageMapper": [
            {
              "name": "username",
              "providerId": "user-attribute-ldap-mapper",
              "config": {
                "ldap.attribute": ["uid"], "user.model.attribute": ["username"],
                "read.only": ["true"], "always.read.value.from.ldap": ["false"], "is.mandatory.in.ldap": ["true"]
              }
            },
            {
              "name": "first name",
              "providerId": "user-attribute-ldap-mapper",
              "config": {
                "ldap.attribute": ["givenName"], "user.model.attribute": ["firstName"],
                "read.only": ["true"], "always.read.value.from.ldap": ["true"], "is.mandatory.in.ldap": ["false"]
              }
            },
            {
              "name": "last name",
              "providerId": "user-attribute-ldap-mapper",
              "config": {
                "ldap.attribute": ["sn"], "user.model.attribute": ["lastName"],
                "read.only": ["true"], "always.read.value.from.ldap": ["true"], "is.mandatory.in.ldap": ["true"]
              }
            },
            {
              "name": "email",
              "providerId": "user-attribute-ldap-mapper",
              "config": {
                "ldap.attribute": ["mail"], "user.model.attribute": ["email"],
                "read.only": ["true"], "always.read.value.from.ldap": ["false"], "is.mandatory.in.ldap": ["false"]
              }
            },
            {
              "name": "realm roles from groups",
              "providerId": "role-ldap-mapper",
              "config": {
                "roles.dn": ["ou=groups,dc=idlab,dc=example"],
                "role.name.ldap.attribute": ["cn"],
                "role.object.classes": ["groupOfNames"],
                "membership.ldap.attribute": ["member"],
                "membership.attribute.type": ["DN"],
                "membership.user.ldap.attribute": ["uid"],
                "user.roles.retrieve.strategy": ["LOAD_ROLES_BY_MEMBER_ATTRIBUTE"],
                "memberof.ldap.attribute": ["memberOf"],
                "mode": ["READ_ONLY"],
                "use.realm.roles.mapping": ["true"]
              }
            }
          ]
        }
      }
    ]
  },
  "clients": [
    {
      "clientId": "https://${LAB_HOST}:${SAML_SP_PORT}/saml/metadata",
      "name": "SAML SP sample app",
      "protocol": "saml",
      "enabled": true,
      "frontchannelLogout": false,
      "rootUrl": "https://${LAB_HOST}:${SAML_SP_PORT}",
      "baseUrl": "/",
      "redirectUris": ["https://${LAB_HOST}:${SAML_SP_PORT}/*"],
      "defaultClientScopes": [],
      "optionalClientScopes": [],
      "attributes": {
        "saml_assertion_consumer_url_post": "https://${LAB_HOST}:${SAML_SP_PORT}/saml/acs",
        "saml.server.signature": "true",
        "saml.assertion.signature": "true",
        "saml.signature.algorithm": "RSA_SHA256",
        "saml_signature_canonicalization_method": "http://www.w3.org/2001/10/xml-exc-c14n#",
        "saml.client.signature": "true",
        "saml.signing.certificate": "${SP_SIGNING_CERT}",
        "saml.authnstatement": "true",
        "saml.force.name.id.format": "true",
        "saml_name_id_format": "email",
        "saml.encrypt": "false"
      },
      "protocolMappers": [
        {
          "name": "email",
          "protocol": "saml",
          "protocolMapper": "saml-user-property-mapper",
          "config": { "user.attribute": "email", "attribute.name": "email", "attribute.nameformat": "Basic" }
        },
        {
          "name": "givenName",
          "protocol": "saml",
          "protocolMapper": "saml-user-property-mapper",
          "config": { "user.attribute": "firstName", "attribute.name": "givenName", "attribute.nameformat": "Basic" }
        },
        {
          "name": "surname",
          "protocol": "saml",
          "protocolMapper": "saml-user-property-mapper",
          "config": { "user.attribute": "lastName", "attribute.name": "surname", "attribute.nameformat": "Basic" }
        },
        {
          "name": "roles",
          "protocol": "saml",
          "protocolMapper": "saml-role-list-mapper",
          "config": { "single": "true", "attribute.name": "role", "attribute.nameformat": "Basic" }
        }
      ]
    },
    {
      "clientId": "oidc-rp",
      "name": "OIDC RP sample app",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${OIDC_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "rootUrl": "https://${LAB_HOST}:${OIDC_RP_PORT}",
      "baseUrl": "/",
      "redirectUris": ["https://${LAB_HOST}:${OIDC_RP_PORT}/auth/callback"],
      "webOrigins": ["https://${LAB_HOST}:${OIDC_RP_PORT}"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://${LAB_HOST}:${OIDC_RP_PORT}/"
      },
      "protocolMappers": [
        {
          "name": "audience idlab-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "idlab-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "realm roles in ID token",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "realm_roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "https://${LAB_HOST}:${PROXY_SAML_SP_PORT}/saml/metadata",
      "name": "SAML SP sample app, behind the reverse proxy",
      "protocol": "saml",
      "enabled": true,
      "frontchannelLogout": false,
      "rootUrl": "https://${LAB_HOST}:${PROXY_SAML_SP_PORT}",
      "baseUrl": "/",
      "redirectUris": ["https://${LAB_HOST}:${PROXY_SAML_SP_PORT}/*"],
      "defaultClientScopes": [],
      "optionalClientScopes": [],
      "attributes": {
        "saml_assertion_consumer_url_post": "https://${LAB_HOST}:${PROXY_SAML_SP_PORT}/saml/acs",
        "saml.server.signature": "true",
        "saml.assertion.signature": "true",
        "saml.signature.algorithm": "RSA_SHA256",
        "saml_signature_canonicalization_method": "http://www.w3.org/2001/10/xml-exc-c14n#",
        "saml.client.signature": "true",
        "saml.signing.certificate": "${SP_SIGNING_CERT}",
        "saml.authnstatement": "true",
        "saml.force.name.id.format": "true",
        "saml_name_id_format": "email",
        "saml.encrypt": "false"
      },
      "protocolMappers": [
        {
          "name": "email",
          "protocol": "saml",
          "protocolMapper": "saml-user-property-mapper",
          "config": { "user.attribute": "email", "attribute.name": "email", "attribute.nameformat": "Basic" }
        },
        {
          "name": "givenName",
          "protocol": "saml",
          "protocolMapper": "saml-user-property-mapper",
          "config": { "user.attribute": "firstName", "attribute.name": "givenName", "attribute.nameformat": "Basic" }
        },
        {
          "name": "surname",
          "protocol": "saml",
          "protocolMapper": "saml-user-property-mapper",
          "config": { "user.attribute": "lastName", "attribute.name": "surname", "attribute.nameformat": "Basic" }
        },
        {
          "name": "roles",
          "protocol": "saml",
          "protocolMapper": "saml-role-list-mapper",
          "config": { "single": "true", "attribute.name": "role", "attribute.nameformat": "Basic" }
        }
      ]
    },
    {
      "clientId": "oidc-rp-proxied",
      "name": "OIDC RP sample app, behind the reverse proxy",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${OIDC_PROXIED_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "rootUrl": "https://${LAB_HOST}:${PROXY_OIDC_RP_PORT}",
      "baseUrl": "/",
      "redirectUris": ["https://${LAB_HOST}:${PROXY_OIDC_RP_PORT}/auth/callback"],
      "webOrigins": ["https://${LAB_HOST}:${PROXY_OIDC_RP_PORT}"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://${LAB_HOST}:${PROXY_OIDC_RP_PORT}/"
      },
      "protocolMappers": [
        {
          "name": "realm roles in ID token",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "realm_roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "oidc-rp-egress",
      "name": "OIDC RP sample app, calling Keycloak through the egress proxy",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${OIDC_EGRESS_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "rootUrl": "https://${LAB_HOST}:${EGRESS_OIDC_RP_PORT}",
      "baseUrl": "/",
      "redirectUris": ["https://${LAB_HOST}:${EGRESS_OIDC_RP_PORT}/auth/callback"],
      "webOrigins": ["https://${LAB_HOST}:${EGRESS_OIDC_RP_PORT}"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://${LAB_HOST}:${EGRESS_OIDC_RP_PORT}/"
      },
      "protocolMappers": [
        {
          "name": "realm roles in ID token",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "realm_roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "oidc-rp-edge",
      "name": "OIDC RP sample app, behind the reverse proxy on plain HTTP",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${OIDC_EDGE_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "rootUrl": "https://${LAB_HOST}:${PROXY_EDGE_RP_PORT}",
      "baseUrl": "/",
      "redirectUris": ["https://${LAB_HOST}:${PROXY_EDGE_RP_PORT}/auth/callback"],
      "webOrigins": ["https://${LAB_HOST}:${PROXY_EDGE_RP_PORT}"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://${LAB_HOST}:${PROXY_EDGE_RP_PORT}/"
      },
      "protocolMappers": [
        {
          "name": "realm roles in ID token",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "realm_roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ]
}
